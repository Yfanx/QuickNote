{
  "name": "quicknote",
  "version": "4.7.1",
  "description": "Keyboard-driven local quick capture",
  "author": "QuickNote",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "test": "node tests/run.cjs"
  },
  "build": {
    "appId": "local.quicknote.desktop",
    "productName": "QuickNote",
    "directories": {
      "output": "release/4.7.1"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/store.cjs",
      "assets/app-*.png",
      "assets/app.ico",
      "assets/tray/**/*",
      "assets/icons/**/*",
      "assets/THIRD_PARTY_NOTICES.txt",
      "electron/time.cjs",
      "electron/reminders.cjs",
      "electron/updates.cjs",
      "electron/startup.cjs",
      "electron/workspace.cjs"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "assets/app.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Yfanx",
      "repo": "QuickNote",
      "releaseType": "release"
    },
    "artifactName": "QuickNote-Setup-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "framer-motion": "^14.10.1",
    "lucide-react": "^0.468.0",
    "lunar-javascript": "^1.7.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
